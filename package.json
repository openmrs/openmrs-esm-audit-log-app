{
  "name": "@openmrs/esm-audit-log-app",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "Audit log microfrontend for OpenMRS O3: system-wide admin dashboard and per-patient audit history chart tab",
  "browser": "dist/openmrs-esm-audit-log-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "rspack serve --mode=development",
    "build": "rspack --mode production",
    "analyze": "rspack --mode=production --env analyze=true",
    "lint": "eslint src --ext js,jsx,ts,tsx --max-warnings 0",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\" --list-different",
    "typescript": "tsc",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "verify": "turbo lint typescript test",
    "prepare": "husky install",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/**/*.modal.tsx' 'src/**/*.extension.tsx' 'src/**/*.workspace.tsx' 'src/**/*.hook.tsx' 'src/index.ts' --config ./tools/i18next-parser.config.js"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "microfrontends",
    "audit-log"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RajPrakash681/openmrs-esm-audit-log-app.git"
  },
  "homepage": "https://github.com/RajPrakash681/openmrs-esm-audit-log-app#readme",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/RajPrakash681/openmrs-esm-audit-log-app/issues"
  },
  "dependencies": {
    "@carbon/react": "~1.92.1",
    "@openmrs/esm-patient-common-lib": "next"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "10.x",
    "dayjs": "1.x",
    "i18next": "25.x",
    "react": "18.x",
    "react-i18next": "16.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "next",
    "@openmrs/esm-styleguide": "next",
    "@swc/cli": "^0.3.12",
    "@swc/core": "^1.3.68",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.6",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.13",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-jest-dom": "^5.4.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "happy-dom": "^20.0.0",
    "husky": "^8.0.3",
    "i18next": "^25.0.0",
    "i18next-parser": "^9.3.0",
    "identity-obj-proxy": "^3.0.0",
    "lint-staged": "^15.2.2",
    "openmrs": "next",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^6.14.1",
    "rxjs": "^6.6.7",
    "swr": "^2.2.5",
    "turbo": "^2.5.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "eslint --cache --fix --max-warnings 0",
    "*.{css,scss,ts,tsx}": "prettier --write --list-different"
  },
  "packageManager": "yarn@4.10.3"
}
